:root{--bg:#08111f;--surface:#0d192b;--text:#f5f7fb;--muted:#9aa8bd;--line:rgba(255,255,255,.12);--lime:#c9f36b;--blue:#77b8ff;--max:1180px}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--text);font-family:'DM Sans',sans-serif;line-height:1.6}a{color:inherit;text-decoration:none}.noise{position:fixed;inset:0;pointer-events:none;opacity:.035;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E")}.section-shell{max-width:var(--max);margin:0 auto;padding-left:28px;padding-right:28px}.site-header{height:82px;max-width:var(--max);margin:auto;padding:0 28px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}.brand{font-family:'Space Grotesk',sans-serif;font-size:17px;font-weight:600;letter-spacing:-.03em}.brand span{display:inline-grid;place-items:center;width:34px;height:34px;margin-right:9px;border:1px solid var(--lime);border-radius:50%;color:var(--lime);font-size:11px;letter-spacing:0}.site-header nav{display:flex;gap:31px;color:var(--muted);font-size:13px}.site-header nav a:hover,.site-footer a:hover{color:var(--lime)}.header-contact{font-size:13px;color:var(--lime)}.header-contact span,.text-link span{display:inline-block;margin-left:7px}.hero{min-height:650px;display:grid;grid-template-columns:1.03fr .97fr;gap:40px;align-items:center;padding-top:74px;padding-bottom:72px}.eyebrow,.section-kicker{margin:0 0 25px;color:var(--lime);font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase}.pulse{display:inline-block;width:7px;height:7px;margin-right:9px;border-radius:50%;background:var(--lime);box-shadow:0 0 0 5px rgba(201,243,107,.12)}h1,h2,h3{font-family:'Space Grotesk',sans-serif;line-height:1.08;letter-spacing:-.055em}h1{max-width:700px;margin:0;font-size:clamp(50px,7vw,88px);font-weight:600}h1 em,h2 em{font-style:normal;color:var(--lime)}.hero-lead{max-width:570px;margin:29px 0 32px;color:var(--muted);font-size:18px;line-height:1.7}.hero-actions{display:flex;align-items:center;gap:25px}.button{display:inline-flex;align-items:center;justify-content:center;gap:9px;padding:14px 21px;border-radius:4px;font-size:13px;font-weight:700;transition:transform .2s,background .2s}.button:hover{transform:translateY(-3px)}.button-primary{background:var(--lime);color:#15200d}.button-primary:hover{background:#dcff8c}.text-link{font-size:13px;color:var(--text);border-bottom:1px solid var(--lime);padding-bottom:4px}.hero-visual{min-height:460px;position:relative;display:grid;place-items:center}.hero-visual:before{content:'';position:absolute;width:370px;height:370px;border:1px solid rgba(119,184,255,.25);border-radius:50%;box-shadow:0 0 90px rgba(119,184,255,.09)}.hero-visual:after{content:'';position:absolute;width:270px;height:270px;border:1px solid rgba(201,243,107,.22);border-radius:50%;transform:rotate(42deg) skew(-10deg)}.orb{position:absolute;border-radius:50%;filter:blur(1px)}.orb-one{width:14px;height:14px;top:24%;right:14%;background:var(--lime);box-shadow:0 0 24px var(--lime)}.orb-two{width:8px;height:8px;bottom:23%;left:15%;background:var(--blue);box-shadow:0 0 22px var(--blue)}.profile-card{position:relative;z-index:1;width:280px;padding:27px;background:rgba(16,31,51,.86);border:1px solid rgba(255,255,255,.18);box-shadow:24px 28px 60px rgba(0,0,0,.28);transform:rotate(-4deg);backdrop-filter:blur(9px)}.avatar{display:grid;place-items:center;width:88px;height:88px;border-radius:50%;margin-bottom:27px;background:linear-gradient(135deg,var(--lime),#4d92d4 75%);color:#0b1825;font-family:'Space Grotesk';font-size:26px;font-weight:700}.profile-card-name{font-family:'Space Grotesk';font-size:22px;font-weight:600}.profile-card-role{margin-top:5px;color:var(--lime);font-size:12px}.profile-card-line{margin-top:34px;padding-top:14px;border-top:1px solid var(--line);color:var(--muted);font-size:11px}.profile-card-line span{display:inline-block;width:6px;height:6px;margin-right:6px;border-radius:50%;background:var(--lime)}.code-float{position:absolute;z-index:2;right:5%;bottom:18%;padding:14px 16px;background:#101e31;border:1px solid var(--line);color:var(--muted);font:12px/1.7 monospace;transform:rotate(7deg);box-shadow:12px 15px 35px #0005}.code-float span{color:var(--blue)}.code-float b{color:var(--lime);font-weight:400}.marquee{overflow:hidden;border-top:1px solid var(--line);border-bottom:1px solid var(--line);color:var(--muted);font-family:'Space Grotesk';font-size:12px;letter-spacing:.16em;text-transform:uppercase;white-space:nowrap}.marquee div{padding:19px 0;text-align:center}.marquee span{padding:0 15px;color:var(--lime)}.section{padding-top:125px;padding-bottom:125px}.section-kicker{padding-bottom:18px;border-bottom:1px solid var(--line)}.profile-grid{display:grid;grid-template-columns:1fr 1fr;gap:90px}.section h2{max-width:560px;margin:0;font-size:clamp(37px,5vw,58px);font-weight:600}.profile-text{max-width:490px;color:var(--muted);font-size:16px}.profile-text p{margin:0 0 22px}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:75px;padding-top:25px;border-top:1px solid var(--line)}.stats strong{display:block;color:var(--lime);font:600 42px 'Space Grotesk'}.stats span{display:block;margin-top:4px;color:var(--muted);font-size:12px}.experience-list{border-top:1px solid var(--line)}.experience-item{display:grid;grid-template-columns:120px 1fr 30px;gap:30px;align-items:start;padding:29px 0;border-bottom:1px solid var(--line)}.experience-year{color:var(--lime);font:12px 'Space Grotesk';text-transform:uppercase;letter-spacing:.09em}.experience-item h3{margin:0;font-size:22px;letter-spacing:-.03em}.experience-item h3 span{color:var(--lime)}.experience-item p{max-width:620px;margin:11px 0 0;color:var(--muted);font-size:14px}.arrow,.card-arrow{color:var(--lime);font-size:21px;text-align:right}.projects-heading{display:flex;align-items:end;justify-content:space-between;gap:30px;margin-bottom:48px}.project-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}.project-card{position:relative;min-height:245px;padding:27px;background:var(--surface);border:1px solid var(--line);display:flex;flex-direction:column;justify-content:space-between;transition:transform .25s,border-color .25s,background .25s}.project-card:hover{transform:translateY(-5px);border-color:var(--lime);background:#11223a}.project-featured{background:linear-gradient(135deg,#162e49,#102236)}.project-number{color:var(--lime);font:11px 'Space Grotesk';letter-spacing:.12em}.project-card h3{margin:27px 0 8px;font-size:30px}.project-card p{max-width:280px;margin:0;color:var(--muted);font-size:14px}.project-tag{display:inline-block;margin-top:22px;color:var(--blue);font-size:11px}.card-arrow{position:absolute;top:25px;right:25px}.contact-section{padding-top:0;padding-bottom:0}.contact-inner{position:relative;overflow:hidden;padding:88px 60px;background:linear-gradient(115deg,#b6e75d,#d9fc81);color:#14200f}.contact-inner:after{content:'↗';position:absolute;right:8%;top:28%;font:180px 'Space Grotesk';opacity:.1}.contact-inner .eyebrow{color:#35551e}.contact-inner h2{margin:0;font-size:clamp(48px,7vw,82px);max-width:550px}.contact-inner h2 em{color:#35551e}.contact-inner p:not(.eyebrow){max-width:450px;margin:19px 0 28px;color:#405c29}.button-light{background:#14200f;color:var(--lime)}.button-light:hover{background:#243a18}.site-footer{display:flex;justify-content:space-between;padding-top:30px;padding-bottom:30px;color:var(--muted);font-size:12px}.site-footer div{display:flex;gap:22px}.site-footer a{color:var(--text)}
